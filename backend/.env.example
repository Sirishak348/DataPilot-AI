# DataPilot AI Environment Configuration

# Application
APP_NAME=DataPilot AI
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Default: SQLite for zero-config local development)
DATABASE_URL=sqlite:///./datapilot.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/datapilot

# Security
SECRET_KEY=datapilot-ai-development-super-secret-key-change-in-production-2025
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=50

# Google Gemini API
# Provide your Gemini API key below to activate AI assistant features
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
